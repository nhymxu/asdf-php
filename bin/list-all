#!/usr/bin/env bash

set -eo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

list_all_versions() {
	local urls=`curl --silent -L https://dl.static-php.dev/static-php-cli/bulk/ | sed -e "s/ /\n/g" | grep -E "(href=|action=)"| grep -oh "'[^']*'" | sed -e 's/"//g' | sed -e "s/'//g" | grep "\." | grep "\.tar\.gz" | grep -oE '[0-9]{1,}.[0-9]{1,}.[0-9]{1,}' | tr ' ' '\n' | sort -u`

	echo $urls
}

check_support_platform
list_all_versions
